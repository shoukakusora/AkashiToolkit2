// 复制为 signing.gradle 后填写自己的签名信息（该文件已被 .gitignore 忽略）。
// 没有 signing.gradle 时，release 构建产出的是未签名 APK。
//
// 推荐用 JKS 密钥库（Android Studio 生成或 keytool 生成）：
//   keytool -genkeypair -v -keystore release.jks -alias akashi -keyalg RSA \
//           -keysize 2048 -validity 10000
//
// 也可以直接写死路径/密码（不要提交到仓库）：
//   storeFile file('../release.jks')
//   storePassword 'your-password'
//   keyAlias 'akashi'
//   keyPassword 'your-password'
android {
    signingConfigs {
        sign {
            storeFile file(System.getenv('AKASHI_KEYSTORE') ?: 'release.jks')
            storeType 'JKS'
            storePassword System.getenv('AKASHI_KEYSTORE_PASSWORD') ?: ''
            keyAlias System.getenv('AKASHI_KEY_ALIAS') ?: ''
            keyPassword System.getenv('AKASHI_KEY_PASSWORD') ?: ''
        }
    }
}
