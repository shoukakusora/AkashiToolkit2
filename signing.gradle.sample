// 复制为 signing.gradle 并填入自己的签名信息（该文件已被 .gitignore 忽略）。
// 不提供 signing.gradle 时，release 构建产出的是未签名 APK。
apply plugin: 'com.android.application'

android {
    signingConfigs {
        sign {
            storeFile file(System.getenv('AKASHI_KEYSTORE') ?: 'release.keystore')
            storePassword System.getenv('AKASHI_KEYSTORE_PASSWORD') ?: ''
            keyAlias System.getenv('AKASHI_KEY_ALIAS') ?: ''
            keyPassword System.getenv('AKASHI_KEY_PASSWORD') ?: ''
        }
    }
}
